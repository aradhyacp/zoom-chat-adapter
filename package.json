{
  "name": "zoom-chat-adapter",
  "version": "1.0.1",
  "description": "Zoom Team Chat adapter for chat-sdk",
  "keywords": [
    "chat",
    "chat-sdk",
    "chat-adapter",
    "chat-adapter-sdk",
    "chat-adapter-sdk-zoom",
    "chat-adapter-sdk-zoom-team-chat",
    "zoom-chat-adapter",
    "zoom-chat",
    "zoom-team-chat",
    "agents",
    "apps",
    "zoom",
    "bot",
    "adapter",
    "messaging",
    "team-chat"
  ],
  "homepage": "https://zoom-chat-adapter.vercel.app",
  "bugs": {
    "url": "https://github.com/aradhyacp/zoom-chat-adapter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aradhyacp/zoom-chat-adapter.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:all": "pnpm build && turbo run build --filter=docs",
    "build:docs": "turbo run build --filter=docs",
    "check": "ultracite check",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "dev:docs": "turbo run dev --filter=docs",
    "docs": "turbo run dev --filter=docs",
    "fix": "ultracite fix",
    "prepare": "husky",
    "prepublish": "pnpm build && pnpm test && pnpm check && pnpm typecheck && echo \"allowed to publish\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chat-adapter/shared": "^4.24.0",
    "chat": "^4.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.3.2",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.1.7",
    "tsup": "^8.3.5",
    "turbo": "^2.5.4",
    "typescript": "^5.7.2",
    "ultracite": "8.0.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@11.0.9",
  "publishConfig": {
    "access": "public"
  }
}
